# =============================================================================
# ToyotaWaits.ca Environment Variables Configuration
# =============================================================================
# Copy this template to .env.local for local development:
#   cp .env.example .env.local
#
# For production deployments (e.g. Vercel), add these variables in your project settings.

# -----------------------------------------------------------------------------
# Base URL Configuration
# -----------------------------------------------------------------------------
# Canonical URL for OpenGraph metadata, sitemaps, and social cards
NEXT_PUBLIC_BASE_URL=https://toyotawaits.ca

# -----------------------------------------------------------------------------
# Supabase Database & API Configuration
# -----------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Server-Side Service Role Key (Keep secret! Never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Direct PostgreSQL Connection String (used for running migrations or Prisma/Drizzle/pg)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Cloudflare Turnstile Bot Protection
# -----------------------------------------------------------------------------
# Register your domain at Cloudflare Dashboard -> Turnstile
# For local testing, use Cloudflare's dummy test keys:
# Site Key: 1x00000000000000000000AA (always passes)
# Secret Key: 1x0000000000000000000000000000000AA (always passes)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# -----------------------------------------------------------------------------
# Upstash Redis (Optional - Distributed Rate Limiting)
# -----------------------------------------------------------------------------
# Create a free serverless Redis database at https://upstash.com
# If omitted, memory-based fallback rate limiting is used automatically.
UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token-here
